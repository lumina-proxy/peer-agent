[Unit]
Description=LuminaProxy peer agent (opt-in bandwidth sharing)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/luminaproxy/peer-agent.env
ExecStart=/usr/bin/peer-agent
Restart=on-failure
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
